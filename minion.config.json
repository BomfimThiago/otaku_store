{
  "repo": {
    "source": "git@github.com:BomfimThiago/otaku_store.git",
    "defaultBranch": "develop",
    "integrationBranch": "develop"
  },
  "parallelism": 1,
  "commands": {
    "lint": "cd store && npm install --no-audit --no-fund --silent && npm run typecheck",
    "test": "cd store && npm run test",
    "e2e": "cd store && npm run test:e2e"
  },
  "frontendGlobs": ["store/web/**"],
  "evals": [
    { "name": "diff-size", "options": { "maxFiles": 30 } },
    { "name": "no-debug-artifacts" },
    { "name": "tests-with-frontend" }
  ],
  "attemptCeiling": 2
}
