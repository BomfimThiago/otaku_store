# Copy this file to `.env` and fill in the real values.
# `.env` is git-ignored — never commit real secrets.

# GitHub Personal Access Token (fine-grained, scoped to the target repo:
# contents + pull requests; merge permission for the develop -> main promotion).
# Used by: GitHub MCP (agent reads) and git/gh CLI (deterministic write ops).
GITHUB_TOKEN=

# Tavily search API key — https://tavily.com
# Used by: context_gatherer "official sources" subagent.
TAVILY_API_KEY=

# Anthropic API key — OPTIONAL. Only needed if you are NOT authenticated through
# a local Claude Code login. Used by: the Agent SDK (@anthropic-ai/claude-agent-sdk).
# ANTHROPIC_API_KEY=

# Context7 API key — optional. Works keyless for basic use.
# Used by: context_gatherer "official sources" subagent (version-pinned docs).
CONTEXT7_API_KEY=

# Secret used to sign the "sid" auth session cookie (@fastify/cookie).
# Used by: store/api. Falls back to an insecure dev default when unset —
# always set a real value in production.
COOKIE_SECRET=

# --- Only for a public/VPS deployment of the console (see deploy/vps-setup.sh) ---

# Optional access token for the live trigger. If set, POST /api/trigger (and the
# console URL) require ?token=<this>. Leave empty to keep the trigger open.
TRIGGER_TOKEN=

# Overrides where triggered runs clone from. On a server with no SSH key, use the
# HTTPS URL so `gh auth setup-git` credentials apply. Local dev can leave this unset.
# MINION_REPO_SOURCE=https://github.com/BomfimThiago/otaku_store.git
